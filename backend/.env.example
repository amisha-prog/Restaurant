# Example Environment Variables for Backend
# Render automatically PORT provide karta hai, default 5001 local dev ke liye
PORT=5001

# MongoDB Atlas connection string (Render Dashboard -> Environment Variables me add karein)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/restaurant_db?retryWrites=true&w=majority

# JWT Secret Key (Optional / if used for tokens)
JWT_SECRET=your_jwt_secret_key_here

# Production Frontend URL (Vercel deployment URL - CORS & QR codes ke liye)
# Example: https://restaurant-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
